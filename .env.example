# Konfiguracja bazy danych (domyslnie SQLite dla szybkiego startu demo; w produkcji/Docker PostgreSQL)
# Przyklad PostgreSQL: postgresql+psycopg://emagazyn:emagazyn@localhost:5432/emagazyn
DATABASE_URL=sqlite:///./emagazyn_demo.db

# Bezpieczenstwo JWT (w produkcji wygeneruj losowy ciag min. 32 znakow!)
JWT_SECRET_KEY=zmien-mnie-w-srodowisku-produkcyjnym-min-32-znaki
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Tryb pracy i integracje (true = symulator wagi i API GUS z jawnym oznaczeniem)
DEMO_MODE=true
SCALE_SIMULATOR_ENABLED=true
GUS_SIMULATOR_ENABLED=true

# Limity terminala i CORS
TERMINAL_IDLE_TIMEOUT_SECONDS=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
